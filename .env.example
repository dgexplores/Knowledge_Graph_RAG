# Copy to .env and fill in. Never commit a filled-in .env — .gitignore blocks it.
# Every value below ships empty on purpose.

# --- Graph store (Phase 1) ---
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Vector store (Phase 2) ---
POSTGRES_DSN=postgresql://localhost:5432/kg_rag

# --- Models (Phase 1 extraction, Phase 3 router, Phase 4 generation) ---
ANTHROPIC_API_KEY=
# Cheap + fast for the Phase 3 router and bulk Phase 1 extraction
EXTRACTION_MODEL=
ROUTER_MODEL=
# Used for final answer synthesis
GENERATION_MODEL=

# --- Cost control (Phase 1) ---
# Hard ceiling for a full-corpus ingestion run. The script refuses to start above this.
MAX_INGESTION_USD=

# --- Serve (Phase 4) ---
API_KEY=
